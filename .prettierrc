{
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.scss", "**/*.scss"],
      "options": {
        "parser": "scss",
        "singleQuote": false,
        "tabWidth": 4
      }
    }
  ]
}
